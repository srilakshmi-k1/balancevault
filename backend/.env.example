# BalanceVault Backend – Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (Neon or any managed Postgres)
DATABASE_URL="postgresql://user:password@host/balancevault?sslmode=require"

# JWT
JWT_SECRET=your-very-long-random-secret-at-least-64-chars
JWT_EXPIRES_IN=24h

# Redis (optional – falls back to memory rate-limiting if omitted)
REDIS_URL=redis://localhost:6379

# CORS – comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Admin bootstrap (used by prisma/seed.js)
ADMIN_EMAIL=admin@balancevault.com
ADMIN_PASSWORD=Admin@123456
